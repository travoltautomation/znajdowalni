# Skonfiguruj JEDNĄ metodę wysyłki na Vercel. Bez nich formularz pokazuje stan demonstracyjny.
# PREVIEW_WEBHOOK_URL=https://twoj-webhook.example/preview
# RESEND_API_KEY=re_...
# PREVIEW_RECIPIENT_EMAIL=kontakt@twojadomena.pl
# RESEND_FROM_EMAIL="Znajdowalni <kontakt@twojadomena.pl>"
