# SMTP_HOST=ssl0.ovh.net
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=kontakt@znajdowalni.pl
# SMTP_PASS=haslo_skrzynki
# SMTP_FROM_EMAIL="Znajdowalni <kontakt@znajdowalni.pl>"
# SMTP_RECIPIENT_EMAIL=kontakt@znajdowalni.pl
